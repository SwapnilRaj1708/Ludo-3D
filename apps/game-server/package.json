{
  "name": "@ludo3d/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Colyseus game server for Ludo 3D",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@colyseus/testing": "0.18.6",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@colyseus/core": "0.18.26",
    "@colyseus/schema": "5.0.43",
    "@colyseus/tools": "0.18.11",
    "@colyseus/ws-transport": "0.18.4",
    "@ludo3d/shared": "workspace:*",
    "express": "^5.3.0",
    "firebase-admin": "14.5.0",
    "zod": "4.6.7"
  }
}
