{
  "name": "@ludo3d/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:e2e": "NEXT_PUBLIC_E2E=1 NEXT_DIST_DIR=.next-e2e next build",
    "start:e2e": "NEXT_DIST_DIR=.next-e2e next start --port 3100"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@ludo3d/shared": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@tanstack/react-query": "5.105.3",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "postprocessing": "^6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0"
  }
