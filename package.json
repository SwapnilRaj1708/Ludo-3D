{
  "name": "ludo-3d",
  "private": true,
  "version": "0.1.0",
  "description": "Ludo 3D — realistic 3D multiplayer Ludo with animal pieces",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @ludo3d/web --filter @ludo3d/game-server dev",
    "dev:web": "pnpm --filter @ludo3d/web dev",
    "dev:server": "pnpm --filter @ludo3d/game-server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @ludo3d/web test:e2e",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:firebase": "pnpm dlx firebase-tools@15.34.2 emulators:exec --config infra/firebase/firebase.json --project demo-ludo3d --only auth,firestore 'pnpm vitest run --project firebase-rules --project game-server'"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
