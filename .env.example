# ---------------------------------------------------------------------------
# Ludo 3D environment variables. Copy to .env.local (web) / .env (server).
# Never commit real values. NEXT_PUBLIC_* values are embedded in the browser
# bundle and must not contain secrets.
# ---------------------------------------------------------------------------

# --- Web (apps/web) ---------------------------------------------------------
# WebSocket/HTTP origin of the Colyseus game server. Leave empty to disable
# online modes (the menu then shows them as unavailable).
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:2567

# Firebase web app config (optional; enables accounts and profiles).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Use the local Firebase Emulator Suite instead of a real project (development).
NEXT_PUBLIC_FIREBASE_EMULATORS=0

# Exposes read-only test hooks and deterministic scenarios. Test builds only.
NEXT_PUBLIC_E2E=0

# --- Game server (apps/game-server) -----------------------------------------
PORT=2567
# Comma-separated list of web origins allowed to call the HTTP API.
CORS_ORIGINS=http://localhost:3000
# HMAC secret for signing guest tokens. Use a long random value in production.
GUEST_TOKEN_SECRET=change-me-to-a-long-random-string
# Reverse-proxy hops in front of the game server (0 = none). Required behind a
# load balancer so per-IP rate limits use the real client address.
TRUST_PROXY=0
# Firebase Admin (optional). Prefer GOOGLE_APPLICATION_CREDENTIALS pointing at a
# service-account file stored OUTSIDE the repository, or workload identity.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Point the Admin SDK at local emulators (development only).
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
